# Khoa API Gemini LLM (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Thong tin khach san mac dinh cho AI Reply
DEFAULT_HOTEL_NAME=Khach san Muong Thanh
HOTEL_HOTLINE=1900 6868
HOTEL_MANAGER_NAME=Ban Quan ly Khach san

# Cau hinh Co so Du lieu
DATABASE_URL=sqlite:///./hotel_analytics.db

# Thu muc VnCoreNLP (tranh duong dan chua khoang trang tren Windows)
VNCORENLP_DIR=D:/VnCoreNLP

# Khoa API Apify va danh sach Google Maps URLs (cach nhau boi dau phay)
APIFY_API_TOKEN=your_apify_token_here
TARGET_GOOGLE_MAPS_URL=https://maps.app.goo.gl/sample1,https://maps.app.goo.gl/sample2

# Cau hinh bao mat JWT cho REST API Backend
JWT_SECRET_KEY=change_this_to_a_strong_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
